# Copy this file to .env and fill in your values. .env is gitignored - never commit real secrets.
# For Kaggle, set these as Kaggle Secrets instead (the script reads both).

# --- GitHub PAT for opencode-synced config persistence (repo scope) ---
# This token is used by setup_git_auth() to clone/push your SYNC_REPO.
GITHUB_TOKEN=ghp_your_github_pat_here

# Optional alias - ACCESS_TOKEN is also accepted by setup_git_auth().
# ACCESS_TOKEN=ghp_your_github_pat_here

# --- opencode-synced: private repo that stores your OpenCode global config ---
# Format: owner/repo  (the repo must already exist; create with `gh repo create my-opencode-config --private`)
SYNC_REPO=tirforge/my-opencode-config

# --- Cloudflare tunnel (existing) ---
# CF_TOKEN / CLOUDFLARE_API_TOKEN  OR  TUNNEL_TOKEN (Zero Trust JWT, prefer for Kaggle)
# CF_DOMAIN=yourdomain.com
# TUNNEL_NAME=t4host

# --- UI / SSH passwords (existing) ---
# OPENCHAMBER_UI_PASSWORD=changeme
# SSH_PASSWORD=changeme

# --- Model (existing) ---
# MODEL=lmstudio-community/Qwen3-Coder-30B-A3B-Instruct-GGUF
